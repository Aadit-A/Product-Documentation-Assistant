FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_DEPLOYMENT=<your-chat-model-deployment>
EMBEDDING_MODEL_DEPLOYMENT=text-embedding-3-small
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<optional-if-not-using-entra>
AZURE_SEARCH_INDEX_NAME=product-docs
AZURE_SEARCH_CONNECTION_NAME=<foundry-search-connection-name>
CONTENT_UNDERSTANDING_ENDPOINT=https://<foundry-resource>.services.ai.azure.com
CONTENT_UNDERSTANDING_API_KEY=<your-key-if-using-key-auth>
AZURE_STORAGE_CONNECTION_STRING=<optional>
AZURE_STORAGE_CONTAINER=product-documents
PUBLIC_APP_URL=http://localhost:8000
FOUNDRY_AGENT_NAME=product-documentation-agent
SEARCH_TOP_K=5
CHUNK_SIZE=1400
CHUNK_OVERLAP=180

FRONTEND_ORIGIN=http://localhost:5173
