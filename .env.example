# Azure OpenAI / Foundry resource using the OpenAI v1 API
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=produc-ass

# Azure Content Understanding - required for PDF ingestion
CONTENT_UNDERSTANDING_ENDPOINT=
CONTENT_UNDERSTANDING_API_KEY=

# Azure Blob Storage - original PDFs are stored here when configured
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=product-documents

# Local application
PUBLIC_APP_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173

# RAG tuning
SEARCH_TOP_K=5
CHUNK_SIZE=1400
CHUNK_OVERLAP=180
